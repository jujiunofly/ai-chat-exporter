# Keep source-review archives limited to source-controlled inputs.
# git archive does not recurse directory-only patterns, so generated directories use /**.
node_modules/** export-ignore
build/** export-ignore
.plasmo/** export-ignore
ai-chat-exporter/** export-ignore

# Archives, caches, and environment files are never source-review inputs.
*.zip export-ignore
*.tsbuildinfo export-ignore
.env export-ignore
.env.* export-ignore

# Ignore common generated and local-only output if it is ever tracked accidentally.
coverage/** export-ignore
dist/** export-ignore
tmp/** export-ignore
.DS_Store export-ignore
